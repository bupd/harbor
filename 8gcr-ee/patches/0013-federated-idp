+		qs = qs.Filter("robot_id", *robotID)
+	}
+	// If neither idpOnly nor robotID specified, return all claims
+
+	// Apply claim_path filter
+	if claimPath != "" {
+		qs = qs.Filter("claim_path", claimPath)
+	}
+
+	var rules []model.ClaimRule
+	_, err = qs.All(&rules)
