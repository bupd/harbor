+			expectedTrim:   "myidp",
+			shouldValidate: true,
+		},
+		{
+			name:           "trailing spaces",
+			input:          "myidp  ",
+			expectedTrim:   "myidp",
+			shouldValidate: true,
+		},
+		{
+			name:           "both leading and trailing",
+			input:          "  myidp  ",
+			expectedTrim:   "myidp",
+			shouldValidate: true,
+		},
+		{
+			name:           "only spaces - becomes empty after trim",
