+            return [];
+        }
+
+        // Builds rules for new claims to insert (trimmed values)
+        return claimsToAdd
+            .filter(claim => claim.path?.trim() && claim.value?.trim())
+            .map(claim => ({
+                claim_path: claim.path.trim(),
+                value: claim.value.trim(),
+                identity_provider_id: id,
