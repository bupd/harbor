+        items:
+          type: string
+      offline_validation:
+        type: boolean
+        description: >-
+          Whether to perform offline validation.
+          - true: use jwks_keys (required), issuer (required) for offline validation.
+          - false: Only `name` and `openid_config_url` are required. All other fields
