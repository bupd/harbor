+    assembleClaimsToAddRules(claimsToAdd: Claim[], id: number) {
+        if (!claimsToAdd || !Array.isArray(claimsToAdd)) {
+            console.error("Input 'claimsToAdd' is not a valid array.");
+            return [];
+        }
+        if (id === 0 || id === undefined) {
