+                } else {
+                    this.claims.push({
+                        path: 'iss',
+                        value: '',
+                    });
+                }
+            }
+
+            if (configObject.jwks_uri) {
+                this.target.jwks_uri = configObject.jwks_uri;
+            } else {
+                this.target.jwks_uri = '';
+            }
+
