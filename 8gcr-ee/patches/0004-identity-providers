+                            // If found, update the value only
+                            this.claims[existingIndex].value =
+                                this.target.issuer;
+                        } else {
+                            // If not found, push the new object
+                            this.claims.push({
+                                path: 'iss',
+                                value: this.target.issuer,
+                            });
