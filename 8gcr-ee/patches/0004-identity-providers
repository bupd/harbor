+        try {
+            // Attempt to parse the string into an object
+            const configObject = JSON.parse(this.openIDConfigJSON);
+            // logic to update claims based on configObject
+            // console.log('Valid JSON:', configObject);
+
+            if (configObject.issuer) {
+                isvalid = true;
