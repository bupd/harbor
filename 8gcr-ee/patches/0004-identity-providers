+func TestValidateUpdateImmutableFields(t *testing.T) {
+	api := &fedIDPAPI{}
+
+	// Helper to create a pointer to string
+	strPtr := func(s string) *string { return &s }
+	boolPtr := func(b bool) *bool { return &b }
