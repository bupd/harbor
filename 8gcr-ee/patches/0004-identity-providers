+
+	// Base existing IdP in offline mode
+	existingOffline := &models.FederatedIdp{
+		ID:                2,
+		Name:              "offline-idp",
+		Description:       "Offline description",
+		Issuer:            "https://offline.example.com",
+		OfflineValidation: true,
