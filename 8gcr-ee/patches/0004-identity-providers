+                                    console.error(
+                                        '❌ Invalid OpenID Configuration: Unable to update Claims Supported.'
+                                    );
+
+                                    const message =
+                                        'Invalid OpenID Configuration: Unable to update Claims Supported.';
+
+                                    this.inlineAlert.showInlineError(message);
+                                    this.openIDConfigJSON =
+                                        'Invalid OpenID Configuration';
+                                }
+                            },
