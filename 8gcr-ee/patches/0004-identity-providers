+        // Check for duplicate paths
+        const duplicateIndex = this.findDuplicateClaimIndex();
+        if (duplicateIndex !== -1) {
+            this.claims[duplicateIndex].error = 'Duplicate claim path';
+            isValid = false;
+        }
