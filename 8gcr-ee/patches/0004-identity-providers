+import {
+    Component,
+    OnInit,
+    OnDestroy,
+    ViewChild,
+    AfterViewInit,
+} from '@angular/core';
+import {
+    Subscription,
+    Observable,
+    forkJoin,
+    throwError as observableThrowError,
+} from 'rxjs';
