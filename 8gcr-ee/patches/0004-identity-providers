+
+@Component({
+    selector: 'hbr-create-edit-idp',
+    templateUrl: './create-edit-idp.component.html',
+    styleUrls: ['./create-edit-idp.component.scss'],
+})
+export class CreateEditIdpComponent
+    implements AfterViewChecked, OnDestroy, OnInit
+{
