+    /**
+     * Find the index of a duplicate claim path
+     */
+    findDuplicateClaimIndex(): number {
+        const seen = new Map<string, number>();
+        for (let i = 0; i < this.claims.length; i++) {
+            const p = (this.claims[i]?.path || '').trim().toLowerCase();
+            if (p && seen.has(p)) {
