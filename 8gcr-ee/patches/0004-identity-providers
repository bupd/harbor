+// validateIDPClaims checks that the token contains all required IdP-level claims
+// IdP-level claims are those with robot_id=0
+func validateIDPClaims(ctx context.Context, idpID int64, parsedToken jwxjwt.Token) error {
+	idpClaims, err := federatedidp.Ctl.ListClaimsIdpOnly(ctx, idpID, "")
+	if err != nil {
+		return fmt.Errorf("failed to list IdP claims: %w", err)
+	}
+
+	for _, claim := range idpClaims {
+		var tokenVal any
+		if err := parsedToken.Get(claim.ClaimPath, &tokenVal); err != nil {
+			return fmt.Errorf("required claim %s not in token: %w", claim.ClaimPath, err)
+		}
+
+		tokenValStr, err := claimToString(tokenVal)
+		if err != nil {
+			return fmt.Errorf("claim %s has invalid type: %w", claim.ClaimPath, err)
+		}
+
+		if strings.TrimSpace(tokenValStr) != strings.TrimSpace(claim.Value) {
+			return fmt.Errorf("claim %s mismatch: want %q, got %q", claim.ClaimPath, claim.Value, tokenValStr)
+		}
+	}
+
+	return nil
+}
+
+// claimToString converts a claim value to string, handling arrays
+func claimToString(val any) (string, error) {
+	switch v := val.(type) {
+	case string:
+		return v, nil
+	case []string:
+		if len(v) == 0 {
+			return "", fmt.Errorf("empty string array")
+		}
+		return v[0], nil
+	case []any:
+		if len(v) == 0 {
+			return "", fmt.Errorf("empty array")
+		}
+		s, ok := v[0].(string)
+		if !ok {
+			return "", fmt.Errorf("array element is not string")
+		}
+		return s, nil
+	default:
+		return fmt.Sprintf("%v", v), nil
+	}
+}
