+
+    ngOnInit() {
+        this.getAndSetBrandingConfig();
+    }
+
+    ngAfterViewChecked() {
+        this.changeDetectorRef.detectChanges();
+    }
+
+    getAndSetBrandingConfig() {
+        this.skinableConfig.getBrandingInfo(false).subscribe({
+            next: branding => {
+                console.log('branding data in admin fetch', branding);
+                // use branding.product.name instead of skinableConfig
+                if (branding) {
+                    this.brandingConfig = JSON.stringify(branding, null, 2);
+                    this.brandingConfigCopy = JSON.stringify(branding, null, 2);
+                }
+            },
+            error: () => {
+                // fallback on error
+                console.error('branding config load failed in admin fetch');
+            },
+        });
+    }
+
+    public isValid(): boolean {
+        return this.brandingForm && this.brandingForm.valid;
+    }
+
+    public hasChanges(): boolean {
+        return this.hasBrandingChanged();
+    }
+
+    private sortKeysDeep(obj: any): any {
+        if (Array.isArray(obj)) {
+            return obj.map(v => this.sortKeysDeep(v)); // ← sort values in array
+        } else if (obj !== null && typeof obj === 'object') {
+            return Object.keys(obj)
+                .sort() // ← sort keys at every level
+                .reduce((acc: any, key: string) => {
+                    acc[key] = this.sortKeysDeep(obj[key]); // ← recurse
+                    return acc;
+                }, {});
+        }
+        return obj; // primitive
+    }
+
+    // Utility function to deeply compare JSON objects
+    hasBrandingChanged(): boolean {
+        // parse both JSON values                           ← same as before
+        const oldConfig = JSON.parse(this.brandingConfigCopy || '{}');
+        const newConfig = JSON.parse(this.brandingConfig || '{}');
+
+        // deeply sort both configs
+        const oldSorted = this.sortKeysDeep(oldConfig);
+        const newSorted = this.sortKeysDeep(newConfig);
+
+        // compare normalized output
+        const oldStr = JSON.stringify(oldSorted);
+        const newStr = JSON.stringify(newSorted);
+
+        return oldStr !== newStr; // true if ANY nested change
+    }
+
+    disabled(prop: any): boolean {
+        return !(prop && prop.editable);
+    }
+
+    /**
+     *
+     * Save the changed values
+     *
+     * @memberOf ConfigurationComponent
+     */
+    public save(): void {
+        if (this.hasChanges()) {
+            var brandingconfig: BrandingConfig;
+            try {
+                // Parse JSON string safely and type it  ← changed
+                brandingconfig = JSON.parse(
+                    this.brandingConfig as string
+                ) as BrandingConfig;
+            } catch (e) {
+                console.error('Failed to parse brandingConfig', e); // ← added error handling
+            }
+
+            this.onGoing = true;
+            this.systeminfoService
+                .updateBrandingInfo(brandingconfig)
+                .subscribe({
+                    next: result => {
+                        this.getAndSetBrandingConfig();
+                        // Reload bootstrap option
+                        this.appConfigService.load().subscribe(
+                            () => {},
+                            error =>
+                                console.error(
+                                    'Failed to reload bootstrap option with error: ',
+                                    error
+                                )
+                        );
+                        this.errorHandler.info('CONFIG.SAVE_SUCCESS');
+                        // window.location.reload();
+                    },
+                    error: error => {
+                        this.errorHandler.error(error);
+                    },
+                });
+        }
+    }
+
+    public get inProgress(): boolean {
+        return this.onGoing || this.conf.getLoadingConfigStatus();
+    }
+
+    /**
+     *
+     * Discard current changes if have and reset
+     *
+     * @memberOf ConfigurationComponent
+     */
+    public cancel(): void {
+        // let changes = this.getChanges();
+        if (this.hasChanges()) {
+            this.conf.confirmUnsavedChanges('branding config');
+        } else {
+            // Invalid situation, should not come here
+            console.error('Nothing changed');
+        }
+    }
+}
