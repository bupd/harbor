+package dao
+
+import (
+	"context"
+	"time"
+
+	"github.com/goharbor/harbor/src/lib/log"
+	"github.com/goharbor/harbor/src/lib/orm"
+	model "github.com/goharbor/harbor/src/pkg/branding/models"
+	// "github.com/goharbor/harbor/src/server/v2.0/models"
+)
+
+// DAO defines the interface to access the robot data model
+type DAO interface {
+	// Get ...
+	Get(ctx context.Context) (*model.Branding, error)
+
+	// Update ...
+	Update(ctx context.Context, branding string) error
+}
+
+// New creates a default implementation for Dao
+func New() DAO {
+	return &dao{}
+}
+
+type dao struct{}
+
+func (d *dao) Get(ctx context.Context) (*model.Branding, error) {
+	ormer, err := orm.FromContext(ctx)
+	if err != nil {
+		return nil, err
+	}
+	b := model.Branding{ID: 1} // we always fetch the only row
+	err = ormer.Read(&b)
+	if err != nil {
+		return nil, err
+	}
+	log.Debugf("fetched branding from DB")
+	return &b, nil
+}
+
+func (d *dao) Update(ctx context.Context, params string) error {
+	ormer, err := orm.FromContext(ctx)
+	if err != nil {
+		return err
+	}
+
+	branding := &model.Branding{
+		ID:         int64(1),
+		Config:     params,
+		UpdateTime: time.Now(),
+	}
+
+	// check if row exists
+	existing := &model.Branding{ID: int64(1)}
+	err = ormer.Read(existing)
+
+	if err == orm.ErrNoRows {
+		_, err = ormer.Insert(branding)
+	} else {
+		_, err = ormer.Update(branding, "Config", "UpdateTime")
+	}
+
+	return err
+}
