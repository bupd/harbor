+// claimInput is a helper struct for testing claim validation
+type claimInput struct {
+	idpID   int64
+	robotID int64
+	path    string
+	value   string
+}
+
+// validateClaimBatchForDuplicates validates claims in a batch for duplicates
+// This mirrors the logic in dao.validateUniqueClaims
+func validateClaimBatchForDuplicates(claims []claimInput) error {
+	type key struct {
+		IDP     int64
+		RobotID int64
+		Path    string
+		Value   string
+	}
+	seen := make(map[key]struct{})
+
+	// Also track (idp, path, value) to detect cross-robot duplicates
+	type pathValueKey struct {
+		IDP   int64
+		Path  string
+		Value string
+	}
+	pathValueSeen := make(map[pathValueKey]int64) // maps to robot_id
+
+	for _, c := range claims {
+		// Check exact duplicate
+		k := key{IDP: c.idpID, RobotID: c.robotID, Path: c.path, Value: c.value}
+		if _, ok := seen[k]; ok {
+			return errorf("duplicate claim in input batch for claim_path=%s", c.path)
+		}
+		seen[k] = struct{}{}
+
+		// Check cross-robot duplicate (same path+value on different robots)
+		pvk := pathValueKey{IDP: c.idpID, Path: c.path, Value: c.value}
+		if existingRobot, ok := pathValueSeen[pvk]; ok && existingRobot != c.robotID {
+			return errorf("duplicate claim combination found for claim_path '%s' and value '%s'", c.path, c.value)
+		}
+		pathValueSeen[pvk] = c.robotID
+	}
+
+	return nil
+}
