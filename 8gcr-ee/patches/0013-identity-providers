+		},
+		{
+			name:           "system robot with project IDP - forbidden",
+			robotProjectID: 0,
+			idpProjectID:   1,
+			expectErr:      true,
+			errContains:    "system-level robot can only be linked to system-level identity provider",
+			description:    "System-level robot cannot link to project-level IDP",
+		},
+
+		// Project-level robot tests
+		{
+			name:           "project robot with same project IDP - allowed",
+			robotProjectID: 1,
+			idpProjectID:   1,
+			expectErr:      false,
+			description:    "Project-level robot can link to IDP from same project",
+		},
+		{
+			name:           "project robot with system IDP - allowed",
+			robotProjectID: 1,
+			idpProjectID:   0,
+			expectErr:      false,
+			description:    "Project-level robot can link to system-level IDP",
+		},
+		{
+			name:           "project robot with different project IDP - forbidden",
+			robotProjectID: 1,
+			idpProjectID:   2,
+			expectErr:      true,
+			errContains:    "robot can only be linked to identity provider from the same project or system level",
+			description:    "Project-level robot cannot link to IDP from different project",
+		},
+		{
+			name:           "project robot with different project IDP (larger IDs)",
+			robotProjectID: 100,
+			idpProjectID:   200,
+			expectErr:      true,
+			errContains:    "robot can only be linked to identity provider from the same project or system level",
+			description:    "Cross-project linking forbidden regardless of project IDs",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Logf("Testing: %s", tt.description)
+
+			// Simulate the validation logic from CreateRobot handler
+			err := validateRobotIdPProjectScope(tt.robotProjectID, tt.idpProjectID)
+
+			if tt.expectErr {
+				assert.Error(t, err, "expected error but got none")
+				if tt.errContains != "" {
+					assert.Contains(t, err.Error(), tt.errContains)
+				}
+			} else {
+				assert.NoError(t, err, "expected no error but got: %v", err)
+			}
+		})
+	}
+}
+
+// validateRobotIdPProjectScope validates that a robot can link to a identity provider
+// based on project scope rules:
+// - System-level robot (project_id=0) can only link to system-level IDP (project_id=0)
+// - Project-level robot can link to same-project IDP OR system-level IDP
+func validateRobotIdPProjectScope(robotProjectID, idpProjectID int64) error {
+	if robotProjectID == 0 {
+		// System-level robot can only use system-level IDP
+		if idpProjectID != 0 {
+			return fmt.Errorf("system-level robot can only be linked to system-level identity provider")
+		}
+	} else {
+		// Project-level robot can use same-project IDP or system-level IDP
+		if idpProjectID != 0 && idpProjectID != robotProjectID {
+			return fmt.Errorf("robot can only be linked to identity provider from the same project or system level")
+		}
+	}
+	return nil
+}
+
+// TestRobotIdPProjectScopeMatrix provides comprehensive test matrix
+func TestRobotIdPProjectScopeMatrix(t *testing.T) {
+	matrix := []struct {
+		robotLevel string
+		idpLevel   string
+		allowed    bool
+	}{
+		{"system (0)", "system (0)", true},
+		{"system (0)", "project (1)", false},
+		{"system (0)", "project (2)", false},
+		{"project (1)", "system (0)", true},
+		{"project (1)", "project (1)", true},
+		{"project (1)", "project (2)", false},
+		{"project (2)", "system (0)", true},
+		{"project (2)", "project (1)", false},
+		{"project (2)", "project (2)", true},
+	}
+
+	t.Log("=== Robot-IdP Project Scope Matrix ===")
+	t.Log("| Robot Level    | IDP Level      | Allowed |")
+	t.Log("|----------------|----------------|---------|")
+	for _, m := range matrix {
+		allowed := "NO"
+		if m.allowed {
+			allowed = "YES"
+		}
+		t.Logf("| %-14s | %-14s | %-7s |", m.robotLevel, m.idpLevel, allowed)
+	}
+}
