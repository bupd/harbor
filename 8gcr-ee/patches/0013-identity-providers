+// GetAndParseJWK fetches JWKS from a URI
+func GetAndParseJWK(ctx context.Context, jwksURI string) (jwk.Set, error) {
+	set, err := jwk.Fetch(ctx, jwksURI)
+	if err != nil {
+		return nil, fmt.Errorf("failed to fetch JWKS: %w", err)
+	}
+	return set, nil
+}
