+func (fAPI *idpAPI) requireAccess(ctx context.Context, f *pkg.IdentityProvider, action rbac.Action) error {
+	if f.ProjectID > 0 {
+		// Check if project-level identity provider feature is enabled
+		if !config.EnableProjectIDP(ctx) {
+			return errors.ForbiddenError(nil).WithMessage("project-level identity provider feature is not enabled")
+		}
+		var ns any
+		ns = f.ProjectID
+		return fAPI.RequireProjectAccess(ctx, ns, action, rbac.ResourceIdentityProvider)
+	} else if f.ProjectID == 0 {
+		// For system-level identity providers, allow read-only operations (List/Read) for any authenticated user.
+		// This enables project admins to use system-level IdPs when creating idp robot accounts.
+		// Write operations (Create/Update/Delete) still require system admin access.
+		if action == rbac.ActionList || action == rbac.ActionRead {
+			return nil // Already authenticated via RequireAuthenticated() in caller
+		}
+		return fAPI.RequireSystemAccess(ctx, action, rbac.ResourceIdentityProvider)
+	}
+	return errors.ForbiddenError(nil)
+}
