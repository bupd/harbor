+func toRawMessage(v any) json.RawMessage {
+	switch val := v.(type) {
+	case json.RawMessage:
+		return val
+	case []byte:
+		return json.RawMessage(val)
+	case string:
+		return json.RawMessage([]byte(val))
+	default:
+		b, _ := json.Marshal(val) // fallback: encode to JSON
+		return b
+	}
+}
