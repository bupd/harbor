+		IdentityProviderID: p.IdentityProviderID,
+		RobotID:            p.RobotID,
+		ClaimPath:          p.ClaimPath,
+		Value:              p.Value,
+		CreationTime:       strfmt.DateTime(p.CreationTime),
+	}
+}
+
