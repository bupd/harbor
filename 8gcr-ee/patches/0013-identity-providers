+            return [];
+        }
+
+        // 🆕 Builds rules for new claims to insert
+        return claimsToAdd.map(claim => ({
+            claim_path: claim.path,
+            value: claim.value,
+            identity_provider_id: id,
+            action: 'add', // 👈 Added field to explicitly identify the operation
