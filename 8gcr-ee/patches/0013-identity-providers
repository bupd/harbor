+import { IdentityProvider } from 'ng-swagger-gen/models';
+
+@Injectable({
+    providedIn: 'root', // recommended way
+})
+
+/**
+ * Define the service methods to handle Identity Provider (IdP) related operations.
+ *
+ * @abstract
+ * class IdentityProviderService
+ */
+export abstract class IdentityProviderService {
+    /**
+     * Get all identity providers.
+     * Optionally filter by name or query parameters.
+     *
+     * @abstract
+     * @param {string} [idpName]
+     * @param {RequestQueryParams} [queryParams]
+     * @returns {Observable<IdentityProvider[]>}
+     */
+    abstract getIdentityProviders(
+        idpName?: string,
+        queryParams?: RequestQueryParams
+    ): Observable<IdentityProvider[]>;
+
+    /**
+     * Get a specific identity provider by ID.
+     *
+     * @abstract
+     * @param {number | string} idpId
+     * @returns {Observable<IdentityProvider>}
+     */
+    abstract getIdentityProvider(
+        idpId: number | string
+    ): Observable<IdentityProvider>;
+
+    /**
+     * Create a new identity provider.
+     *
+     * @abstract
+     * @param {IdentityProvider} idp
+     * @returns {Observable<any>}
+     */
+    abstract createIdentityProvider(idp: IdentityProvider): Observable<any>;
+
+    /**
+     * Update an existing identity provider by ID.
+     *
+     * @abstract
+     * @param {number | string} idpId
+     * @param {IdentityProvider} idp
+     * @returns {Observable<any>}
+     */
+    abstract updateIdentityProvider(
+        idpId: number | string,
+        idp: IdentityProvider
+    ): Observable<any>;
+
+    /**
+     * Delete a identity provider by ID.
+     *
+     * @abstract
+     * @param {number | string} idpId
+     * @returns {Observable<any>}
+     */
+    abstract deleteIdentityProvider(idpId: number | string): Observable<any>;
+
+    /**
+     * Test connectivity or configuration of a identity provider.
+     *
+     * @abstract
+     * @param {IdentityProvider} idp
+     * @returns {Observable<any>}
+     */
+    abstract pingIdentityProvider(idp: IdentityProvider): Observable<any>;
+
+    /**
+     * Validate if the identity provider is associated with other entities (e.g., users, policies).
+     *
+     * @abstract
+     * @param {number | string} idpId
+     * @returns {Observable<any>}
+     */
+    abstract getIdentityProviderWithAssociations(
+        idpId: number | string
+    ): Observable<any>;
+
+    /**
+     * Get display-friendly name/label or description for a specific IdP type.
+     *
+     * @abstract
+     * @param {string} type
+     * @returns {string}
+     */
+    abstract getIdpTypeLabel(type: string): string;
+
+    /**
+     * Fetch OIDC configuration directly (replaces missing generated client)
+     *
+     * @abstract
+     * @param {string} openidConfigUrl The OpenID Connect discovery document URL
+     * @returns {Observable<any>}
+     */
+    abstract PingIdentityProviderOpenIDConfig(
+        openidConfigUrl: string
+    ): Observable<any>;
+
+    /**
+     * Fetch JWKS (JSON Web Key Set) from JWKS URI
+     */
+    abstract PingIdentityProviderJWKS(
+        jwksUri: string
+    ): Observable<{ [key: string]: any }>;
+}
+
+/**
+ * Implement default service for IdentityProvider.
+ *
+ **
+ * class IdentityProviderDefaultService
+ * extends {IdentityProviderService}
+ */
+@Injectable()
+export class IdentityProviderDefaultService extends IdentityProviderService {
+    private _idpUrl: string;
+
+    constructor(private http: HttpClient) {
+        super();
+        this._idpUrl = `${CURRENT_BASE_HREF}/identity-providers`;
+    }
+
+    public getIdentityProviders(
+        idpName?: string,
+        queryParams?: RequestQueryParams
+    ): Observable<IdentityProvider[]> {
+        if (!queryParams) {
+            queryParams = new RequestQueryParams();
+        }
+        if (idpName) {
+            queryParams = queryParams.set('name', idpName);
+        }
+        const requestUrl = this._idpUrl;
+        return this.http
+            .get(requestUrl, buildHttpRequestOptions(queryParams))
+            .pipe(
+                map(response => response as IdentityProvider[]),
+                catchError(error => observableThrowError(error))
+            );
+    }
+
+    public getIdentityProvider(
+        idpId: number | string
+    ): Observable<IdentityProvider> {
+        if (!idpId || +idpId <= 0) {
+            return observableThrowError('Bad request argument.');
+        }
+        const requestUrl = `${this._idpUrl}/${idpId}`;
+        return this.http.get(requestUrl, HTTP_GET_OPTIONS).pipe(
+            map(response => response as IdentityProvider),
+            catchError(error => observableThrowError(error))
+        );
+    }
+
+    public createIdentityProvider(idp: IdentityProvider): Observable<any> {
+        if (!idp) {
+            return observableThrowError('Invalid Identity Provider.');
+        }
+        const requestUrl = this._idpUrl;
+        return this.http
+            .post<any>(requestUrl, JSON.stringify(idp), HTTP_JSON_OPTIONS)
+            .pipe(catchError(error => observableThrowError(error)));
+    }
+
+    public updateIdentityProvider(
+        idpId: number | string,
+        idp: IdentityProvider
+    ): Observable<any> {
+        if (!idpId || +idpId <= 0) {
+            return observableThrowError('Bad request argument.');
+        }
+        if (!idp) {
+            return observableThrowError('Invalid Identity Provider.');
+        }
+        const requestUrl = `${this._idpUrl}/${idpId}`;
+        return this.http
+            .put<any>(requestUrl, JSON.stringify(idp), HTTP_JSON_OPTIONS)
+            .pipe(catchError(error => observableThrowError(error)));
+    }
+
+    public deleteIdentityProvider(idpId: number | string): Observable<any> {
+        if (!idpId || +idpId <= 0) {
+            return observableThrowError('Bad request argument.');
+        }
+        const requestUrl = `${this._idpUrl}/${idpId}`;
+        return this.http
+            .delete<any>(requestUrl)
+            .pipe(catchError(error => observableThrowError(error)));
+    }
+
+    public pingIdentityProvider(idp: IdentityProvider): Observable<any> {
+        if (!idp) {
+            return observableThrowError('Invalid Identity Provider.');
+        }
+        const requestUrl = `${this._idpUrl}/ping`;
+        return this.http
+            .post<any>(requestUrl, idp, HTTP_JSON_OPTIONS)
+            .pipe(catchError(error => observableThrowError(error)));
+    }
+
+    public getIdentityProviderWithAssociations(
+        idpId: number | string
+    ): Observable<any> {
+        if (!idpId || +idpId <= 0) {
+            return observableThrowError('Bad request argument.');
+        }
+        const requestUrl = `${this._idpUrl}/${idpId}/associations`;
+        return this.http
+            .get<any>(requestUrl, HTTP_GET_OPTIONS)
+            .pipe(catchError(error => observableThrowError(error)));
+    }
+
+    public getIdpTypeLabel(type: string): string {
+        const IDP_TYPE_MAP: { [key: string]: string } = {
+            oidc: 'OpenID Connect',
+            saml: 'SAML',
+            harbor: 'Harbor',
+            ldap: 'LDAP',
+        };
+        return IDP_TYPE_MAP[type] || type;
+    }
+
+    public PingIdentityProviderOpenIDConfig(
+        openidConfigUrl: string
+    ): Observable<any> {
+        if (!openidConfigUrl) {
+            return observableThrowError('Invalid OpenID Configuration URL.');
+        }
+
+        const requestUrl = `${this._idpUrl}/openid-config`; // 👈 backend endpoint
+        // const requestUrl = this._idpUrl;
+        return this.http
+            .post(
+                requestUrl,
+                { openid_config_url: openidConfigUrl },
+                HTTP_JSON_OPTIONS
+            )
+            .pipe(
+                map(response => response as IdentityProvider[]),
+                catchError(error => observableThrowError(error))
+            );
+
+        // return this.http
+        //     .post<{ [key: string]: any }>(
+        //         requestUrl,
+        //         { openid_config_url: openidConfigUrl }, // 👈 body format expected by backend
+        //         HTTP_JSON_OPTIONS
+        //     )
+        //     .pipe(catchError(error => observableThrowError(error)));
+    }
+
+    public PingIdentityProviderJWKS(
+        jwksUri: string
+    ): Observable<{ [key: string]: any }> {
+        if (!jwksUri) {
+            return observableThrowError('Invalid JWKS URI.');
+        }
+
+        const requestUrl = `${this._idpUrl}/jwks`; // 👈 backend endpoint
+        return this.http
+            .post<{ [key: string]: any }>(
+                requestUrl,
+                { jwks: jwksUri }, // 👈 body format expected by backend
+                HTTP_JSON_OPTIONS
+            )
+            .pipe(catchError(error => observableThrowError(error)));
+    }
+}
