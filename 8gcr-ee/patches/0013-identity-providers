+// FindMatchingRobot finds robots where ALL robot claims are present in the token.
+// Returns the robot with the most claims (most specific match).
+// Rules:
+// 1. ALL robot claims must be present in the token (token may have extra claims)
+// 2. IDP-level claims (robot_id = 0) are NOT considered - they're validated separately
+// 3. Robots with zero claims are NOT eligible for matching
+// 4. Among fully matching robots, the one with the most claims wins
+func (d *dao) FindMatchingRobot(ctx context.Context, issuerID int64, tokenClaims jwt.MapClaims) (int64, error) {
+	ormer, err := orm.FromContext(ctx)
+	if err != nil {
+		return 0, err
+	}
+
+	if len(tokenClaims) == 0 {
+		return 0, fmt.Errorf("token has no claims to match")
+	}
+
+	// Build parameterized query conditions for each token claim
+	var conditions []string
+	var claimParams []interface{}
+
+	for k, v := range tokenClaims {
+		conditions = append(conditions, "(cr.claim_path = ? AND cr.value = ?)")
+		claimParams = append(claimParams, k, fmt.Sprintf("%v", v))
+	}
+
+	claimWhereClause := strings.Join(conditions, " OR ")
+
+	// This query:
+	// 1. Groups claims by robot_id (excluding robot_id = 0 which is IDP-level)
+	// 2. For each robot, counts total claims and matched claims
+	// 3. HAVING ensures ALL robot claims are matched (total_claims = matched_claims)
+	// 4. Orders by claim count DESC to get the most specific match first
+	//
+	// Parameter order in SQL:
+	// 1. First SUM's CASE WHEN clause (claimParams)
+	// 2. WHERE clause issuerID
+	// 3. Second SUM's CASE WHEN clause in HAVING (claimParams again)
+	sql := fmt.Sprintf(`
+		SELECT
+			cr.robot_id,
+			COUNT(*) as total_claims,
+			SUM(CASE WHEN (%s) THEN 1 ELSE 0 END) as matched_claims
+		FROM
+			claim_rules cr
+		WHERE
+			cr.identity_provider_id = ?
+			AND cr.robot_id > 0
+		GROUP BY
+			cr.robot_id
+		HAVING
+			COUNT(*) = SUM(CASE WHEN (%s) THEN 1 ELSE 0 END)
+			AND COUNT(*) > 0
+		ORDER BY
+			total_claims DESC
+		LIMIT 1
+	`, claimWhereClause, claimWhereClause)
+
+	// Build params in correct order: [claimParams..., issuerID, claimParams...]
+	var allParams []interface{}
+	allParams = append(allParams, claimParams...)
+	allParams = append(allParams, issuerID)
+	allParams = append(allParams, claimParams...)
+
+	log.Debugf("FindMatchingRobot SQL: %s with params: %v", sql, allParams)
+
+	var robotID int64
+	var totalClaims, matchedClaims int64
+	err = ormer.Raw(sql, allParams...).QueryRow(&robotID, &totalClaims, &matchedClaims)
+	if err == orm.ErrNoRows {
+		log.Debugf("no robots matched your token for issuerID=%d", issuerID)
+		return 0, nil
+	}
+	if err != nil {
+		return 0, fmt.Errorf("failed to query matching robot: %w", err)
+	}
+
+	log.Debugf("FindMatchingRobot found robot_id=%d with %d/%d claims matched", robotID, matchedClaims, totalClaims)
+	return robotID, nil
+}
