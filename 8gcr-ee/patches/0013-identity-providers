+	if m == nil {
+		return pkg.ClaimRule{}
+	}
+
+	return pkg.ClaimRule{
+		ID:                 m.ID,
+		IdentityProviderID: m.IdentityProviderID,
+		RobotID:            m.RobotID,
+		ClaimPath:          m.ClaimPath,
+		Value:              m.Value,
+		CreationTime:       time.Time(m.CreationTime), // convert strfmt.DateTime to time.Time
