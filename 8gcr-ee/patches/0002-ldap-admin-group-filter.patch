 	MemberQueryFilter   string `json:"member_query_filter,omitempty"`
@@ -299,6 +300,10 @@ func (s *Session) SearchUser(username string) ([]model.User, error) {
 // OnBoardUser -- justass am admin sysadmin flag if ldap admin filter matches
 // it doesn't actually onboards the user
 func (s *Session) OnBoardUser(user *model.User) error {
+	isAdmin, err := s.isAdmin(user.Username)
+	if err == nil && isAdmin {
+		user.SysAdminFlag = true
+	}
 	return nil
 }

@@ -306,7 +311,7 @@ func (s *Session) OnBoardUser(user *model.User) error {
 func (s *Session) searchGroup(groupDN string) ([]model.Group, error) {
 	return nil, nil
 }
 
 // SearchGroup -- Search group in ldap authenticator, groupName is LDAP group DN.
 func (s *Session) SearchGroup(groupDN string) ([]model.Group, error) {
 	if _, err := goldap.ParseDN(groupDN); err != nil {
@@ -492,3 +497,20 @@ func (s *Session) normalizeFilter(filter string) string {
 	}
 	return filter
 }
+
+func (s *Session) isAdmin(username string) (bool, error) {
+	if s.groupCfg == nil || len(s.groupCfg.AdminFilter) == 0 {
+		return false, nil
+	}
+	ldapFilter := fmt.Sprintf("(&(%s=%s)%s)", s.ldapBaseCfg.UID, goldap.EscapeFilter(username), s.groupCfg.AdminFilter)
+	result, err := s.ldapConn.Search(goldap.NewSearchRequest(
+		s.ldapBaseCfg.BaseDN,
+		goldap.ScopeWholeSubtree,
+		goldap.NeverDerefAliases,
+		0, 0, false, ldapFilter,
+		[]string{"dn"}, nil))
+	if err != nil {
+		return false, err
+	}
+	return len(result.Entries) > 0, nil
+}
