+func TestIamAuthOption_CapLifetime(t *testing.T) {
+	t.Setenv("AWS_REGION", "us-east-1")
+
+	cfg := &models.PostGreSQL{
+		Host:       "mydb.rds.amazonaws.com",
+		Port:       5432,
+		Username:   "harbor_iam_user",
+		AWSRegion:  "us-east-1",
+		UseIAMAuth: true,
+	}
+
+	opt, err := iamAuthOption(t.Context(), cfg)
+	if err != nil {
+		t.Fatalf("iamAuthOption: %v", err)
+	}
+
+	poolCfg := &pgxpool.Config{}
+	poolCfg.MaxConnLifetime = 30 * time.Minute
+	opt(poolCfg)
+
+	if poolCfg.MaxConnLifetime != iamAuthMaxConnLifetime {
+		t.Errorf("MaxConnLifetime = %v, want %v", poolCfg.MaxConnLifetime, iamAuthMaxConnLifetime)
+	}
+}
